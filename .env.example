# Neon Postgres connection string. Use the pooled host (it contains "-pooler")
# on Vercel. Direct or pooled both work with the serverless driver.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# No trailing slash. Production: https://your-domain.vercel.app
# Leave unset on Vercel Preview so each preview URL can sign in.
BETTER_AUTH_URL=http://localhost:3000

# Required for sign-in. If either is empty, /login says sign-in isn't configured.
# The app still builds. Guest booking does not need these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. Checked on the server for every admin action.
ADMIN_EMAILS=kate@example.com

# Accepted answers to "What is Kate's last name?", comma-separated.
# Each value is NFKC-normalized, trimmed, and compared case-insensitively.
# Example: Yuen,阮
# Compared only on the server. Never use a NEXT_PUBLIC_ variable.
SECURITY_ANSWER=
