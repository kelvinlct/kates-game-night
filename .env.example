# Neon Postgres connection string. Use the pooled host (it contains "-pooler")
# on Vercel. Direct or pooled both work with the serverless driver.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# No trailing slash. Production: https://your-domain.vercel.app
# Leave unset on Vercel Preview so each preview URL can sign in.
BETTER_AUTH_URL=http://localhost:3000

# Optional. If either is empty, the Google button is hidden and the app still builds.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. Checked on the server for every admin action.
ADMIN_EMAILS=kate@example.com

# Answer to "What is Kate's last name?". Compared only on the server.
SECURITY_ANSWER=
